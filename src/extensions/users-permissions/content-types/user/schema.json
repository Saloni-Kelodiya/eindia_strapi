{
  "kind": "collectionType",
  "collectionName": "up_users",
  "info": {
    "name": "user",
    "description": "",
    "singularName": "user",
    "pluralName": "users",
    "displayName": "User"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "username": {
      "type": "string",
      "minLength": 3,
      "unique": true,
      "configurable": false,
      "required": true
    },
    "email": {
      "type": "email",
      "minLength": 6,
      "configurable": false,
      "required": true
    },
    "provider": {
      "type": "string",
      "configurable": false
    },
    "password": {
      "type": "password",
      "minLength": 6,
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "resetPasswordToken": {
      "type": "string",
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "confirmationToken": {
      "type": "string",
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "confirmed": {
      "type": "boolean",
      "default": false,
      "configurable": false
    },
    "blocked": {
      "type": "boolean",
      "default": false,
      "configurable": false
    },
    "role": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.role",
      "inversedBy": "users",
      "configurable": false
    },
    "avatar": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "articles": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::article.article",
      "mappedBy": "Authors"
    },
    "web_stories": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::web-story.web-story",
      "mappedBy": "auther"
    },
    "shows_reviews": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::shows-review.shows-review",
      "mappedBy": "user"
    },
    "web_series_reviews": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::web-series-review.web-series-review",
      "mappedBy": "user"
    },
    "coverImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "location": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "following": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "plugin::users-permissions.user",
      "inversedBy": "followers"
    },
    "followers": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "plugin::users-permissions.user",
      "mappedBy": "following"
    },
    "posts": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::post.post",
      "mappedBy": "author"
    },
    "liked_posts": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::post.post",
      "mappedBy": "likedBy"
    },
    "username_hindi": {
      "type": "string",
      "required": false
    },
    "bio_hindi": {
      "type": "text"
    },
    "bio": {
      "type": "text"
    },
    "notifications": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::notification.notification",
      "mappedBy": "recipient"
    },
    "post_comments": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::post-comment.post-comment",
      "mappedBy": "author"
    },
    "songs": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::song.song",
      "mappedBy": "author"
    },
    "movies": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::movie.movie",
      "mappedBy": "author"
    },
    "celebrities_profiles": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::celebrities-profile.celebrities-profile",
      "mappedBy": "author"
    },
    "tv_shows": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::show.show",
      "mappedBy": "author"
    },
    "web_series": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::web-series.web-series",
      "mappedBy": "author"
    },
    "articles_views": {
      "type": "biginteger"
    },
    "webstory_views": {
      "type": "biginteger"
    },
    "galleries": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::gallery.gallery",
      "mappedBy": "author"
    },
    "news": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::news-item.news-item",
      "mappedBy": "Authors"
    }
  }
}
