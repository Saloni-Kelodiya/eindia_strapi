{
  "kind": "collectionType",
  "collectionName": "galleries",
  "info": {
    "singularName": "gallery",
    "pluralName": "galleries",
    "displayName": "Gallery",
    "description": "Photo galleries"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "description": {
      "type": "text"
    },
    "articles": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::article.article",
      "inversedBy": "gallery"
    },
    "photos": {
      "type": "component",
      "component": "gallary.photo-item",
      "repeatable": true
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "files",
        "images"
      ]
    },
    "fashionCategory": {
      "type": "enumeration",
      "enum": [
        "red-carpet",
        "casual",
        "photoshoot",
        " trends",
        " all",
        "met gala",
        "pink-carpet"
      ]
    },
    "likes": {
      "type": "integer",
      "default": 0
    },
    "celebrity_name": {
      "type": "string"
    },
    "event": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "event_date": {
      "type": "date"
    },
    "language": {
      "type": "enumeration",
      "default": "en ",
      "enum": [
        "en ",
        "hi"
      ]
    },
    "trending": {
      "type": "boolean",
      "default": false
    },
    "categories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::category.category",
      "mappedBy": "galleries"
    },
    "author": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "galleries"
    }
  }
}
