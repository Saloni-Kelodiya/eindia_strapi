{
  "kind": "collectionType",
  "collectionName": "genres",
  "info": {
    "singularName": "genre",
    "pluralName": "genres",
    "displayName": "Genres"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "name"
    },
    "articles": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::article.article",
      "inversedBy": "genres"
    },
    "movies": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::movie.movie",
      "inversedBy": "genres"
    },
    "web_series": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::web-series.web-series",
      "mappedBy": "genres"
    },
    "tv_shows": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::show.show",
      "inversedBy": "genres"
    }
  }
}
